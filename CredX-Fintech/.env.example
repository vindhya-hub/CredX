# =============================================================================
# docker compose configuration (template)
#
#   cd backend && npm run setup:env -- --docker
#
# creates CredX-Fintech/.env from this file with freshly generated secrets
# (only if it does not exist yet). docker compose reads that file
# automatically. It is gitignored: never commit it.
#
# docker-compose.yml refuses to start while a required secret is missing, and
# the backend refuses to start while a secret still holds a placeholder.
# =============================================================================

# --- PostgreSQL (used by the postgres container and the backend) ---------------
POSTGRES_DB=credx
POSTGRES_USER=credx
POSTGRES_PASSWORD=<generated-by-setup-env>

# --- Backend secrets (at least 32 characters, different from each other) --------
JWT_SECRET=<generated-by-setup-env>
JWT_REFRESH_SECRET=<generated-by-setup-env>
CARD_FINGERPRINT_SECRET=<generated-by-setup-env>

# --- Port published on the host (bound to 127.0.0.1; the API is reached via /api) --
FRONTEND_PORT=8080
# false = build the API image without the local embedding model runtime
WITH_EMBEDDINGS=true

# --- Optional ------------------------------------------------------------------------
# Browser origins allowed to call the API directly (the UI itself goes through the
# nginx proxy on the same origin, so this only matters for other clients).
CORS_ORIGINS=http://localhost:8080
# Shared rate-limit store: start the redis service with
#   docker compose --profile redis up
# and set REDIS_URL=redis://redis:6379
REDIS_URL=
# hashing = skip the embedding model download (fully offline)
EMBEDDINGS_PROVIDER=transformers
