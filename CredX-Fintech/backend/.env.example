# =============================================================================
# CredX backend configuration (template)
#
#   npm run setup:env      creates backend/.env from this file with freshly
#                          generated JWT and card-fingerprint secrets (only if
#                          backend/.env does not exist yet; it is never
#                          overwritten).
#
# Then set the database values below. backend/.env is gitignored: never commit
# it. Values in <angle brackets> are placeholders; the server refuses to start
# while a secret still holds one. Commented-out values show the defaults.
# =============================================================================

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the API (1 behind the nginx container),
# so rate limiting sees the real client IP. Leave empty when exposed directly.
TRUST_PROXY=

# --- Database (PostgreSQL) ------------------------------------------------------
# Either a single connection URL...
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# ...or the individual settings (DB_HOST defaults to localhost outside production).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credx
DB_USER=<your-postgres-user>
DB_PASSWORD=<your-postgres-password>
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# Schema management on boot: alter (default in development) | safe (default in
# production: only creates missing tables/columns/indexes) | none.
# DB_SYNC=alter
# DB_LOGGING=false
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_IDLE_MS=10000
# DB_POOL_ACQUIRE_MS=30000
# DB_CONNECT_RETRIES=10
# DB_CONNECT_RETRY_DELAY_MS=3000

# --- Authentication (secrets) -----------------------------------------------------
# Required, at least 32 characters, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generated-by-setup-env>
JWT_REFRESH_SECRET=<generated-by-setup-env>
# Optional key for card fingerprints (duplicate-card detection). When unset it
# is derived from JWT_SECRET. At least 32 characters when set.
CARD_FINGERPRINT_SECRET=<generated-by-setup-env>
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# JWT_ISSUER=credx-api
# JWT_AUDIENCE=credx-app
# bcrypt cost factor (10-15 in production).
# BCRYPT_ROUNDS=12
# No e-mail provider is wired up: set to true locally to receive the password
# reset token in the API response. Always off in production.
# AUTH_EXPOSE_RESET_TOKEN=false
# AUTH_RESET_TOKEN_TTL_MINUTES=15

# --- CORS -------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Defaults to the Vite
# dev server (http://localhost:5173, http://127.0.0.1:5173) outside production
# and to none in production (same-origin through the nginx proxy only).
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------------
# Global limit per IP on /api, stricter limit on auth endpoints, per-user limit
# on the assistant.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
# ASSISTANT_RATE_LIMIT_MAX=30
# Optional shared rate-limit store (several API instances). In-memory when empty.
# REDIS_URL=redis://<host>:6379

# --- Business rules -----------------------------------------------------------------
# TRANSFER_DAILY_LIMIT=5000
# TRANSFER_DAILY_COUNT=5
# LOAN_MAX_ACTIVE=3

# --- Virtual assistant -----------------------------------------------------------------
# transformers = local sentence-embedding model (downloaded once, then cached;
# falls back to the hashing embedder automatically) | hashing = fallback only.
# EMBEDDINGS_PROVIDER=transformers
# EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDINGS_DTYPE=q8
# EMBEDDINGS_CACHE_DIR=
# EMBEDDINGS_WARMUP=true
# EMBEDDINGS_WAIT_MS=2000
# EMBEDDINGS_RETRY_MS=300000
# EMBEDDINGS_CACHE_SIZE=5000
# Score fusion: weighted (keywordWeight * BM25 + (1 - keywordWeight) * cosine) | rrf
# ASSISTANT_FUSION=weighted
# ASSISTANT_KEYWORD_WEIGHT=0.4
# ASSISTANT_RRF_K=60
# ASSISTANT_MIN_SIMILARITY_MODEL=0.3
# ASSISTANT_MIN_SIMILARITY_HASHING=0.2
# ASSISTANT_RELATIVE_CUTOFF=0.85
# ASSISTANT_TOP_K=5
# ASSISTANT_MAX_RECORDS=500
# CURRENCY=INR
# LOCALE=en-IN

# --- Logging ----------------------------------------------------------------------------
# LOG_LEVEL=info
# HTTP_LOG_FORMAT=dev

# --- Demo data (npm run seed, development only) --------------------------------------------
# Passwords left empty are generated randomly and printed once by the seed script.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
