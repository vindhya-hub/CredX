# Frontend configuration (template). Copy to .env.local if you need to change
# anything. Only variables prefixed with VITE_ are embedded in the browser
# bundle, so never put secrets in VITE_* variables.

# Base URL of the API as seen by the browser. Keep the default (same origin,
# proxied by Vite in development and by nginx in Docker), or set a full URL
# such as https://api.example.com/api (then add that site to the backend's
# CORS_ORIGINS).
VITE_API_URL=/api

# Development only (not bundled): where the Vite dev server proxies /api.
DEV_API_PROXY_TARGET=http://localhost:5000
